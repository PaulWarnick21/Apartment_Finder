# ChatGPT plan usage is the default; connect through Preferences in the app.
AI_PROVIDER=chatgpt
# Optional paid API mode requires explicitly setting AI_PROVIDER=api.
# These values are never used as fallback for ChatGPT plan requests.
OPENAI_API_KEY=
OPENAI_MODEL=
# No scan runs at application startup. Approve a bounded plan in the app first.
PORT=4317
# Optional private phone access through Tailscale Serve. Configure BOTH values.
# Use your PC's exact HTTPS Serve origin and your own Tailscale login name.
# AF_REMOTE_ORIGIN=https://your-pc.your-network.ts.net
# AF_REMOTE_USER=you@example.com
# Optional alternate Nominatim-compatible HTTPS search endpoint for location maps.
# MAP_GEOCODER_URL=https://nominatim.openstreetmap.org/search
# Optional absolute path to the locally installed Codex executable for read-only
# account usage checks before Interested-apartment reviews. No resets are consumed.
# Windows discovers the current Codex Store installation automatically when unset.
# Obsolete versioned Store paths recover to the current registered installation.
# AF_CODEX_EXECUTABLE=C:/path/to/codex.exe
