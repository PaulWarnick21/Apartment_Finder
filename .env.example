# ChatGPT plan usage is the default; connect through Preferences in the app.
AI_PROVIDER=chatgpt
# Optional paid API mode requires explicitly setting AI_PROVIDER=api.
# These values are never used as fallback for ChatGPT plan requests.
OPENAI_API_KEY=
OPENAI_MODEL=
# No scan runs at application startup. Approve a bounded plan in the app first.
PORT=4317
